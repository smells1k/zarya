#!/usr/bin/env bash
# GRUB A/B confirmation and boot watchdog helpers for Kubuntu Plasma.
set -Eeuo pipefail

fail() { echo "[zarya-ota-init] ERROR: $*" >&2; exit 1; }
[ "$(id -u)" -eq 0 ] || exec sudo -n "$0" "$@"
[ "$#" -eq 1 ] || {
    echo 'Usage: zarya-ota-init --mark-good | --status | --watchdog | --confirm-desktop' >&2
    exit 2
}
ACTION=$1
SLOT=$(cat /etc/zarya-slot 2>/dev/null || true)
case "$SLOT" in
    A|B) ;;
    *)
        if [ "$ACTION" = --status ]; then
            echo 'Not an installed A/B system.'
        fi
        exit 0
        ;;
esac

command -v grub-editenv >/dev/null || fail 'grub-editenv is not installed'
ESP_DIR=$(mktemp -d /run/zarya-ota-init.XXXXXX)
ESP_MOUNTED=0
cleanup() {
    if [ "$ESP_MOUNTED" -eq 1 ]; then umount "$ESP_DIR" 2>/dev/null || true; fi
    rmdir "$ESP_DIR" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

mount_esp() {
    mount -t vfat -L ZARYA_EFI "$ESP_DIR" || fail 'cannot mount the EFI system partition'
    ESP_MOUNTED=1
    ENVFILE="$ESP_DIR/boot/grub/grubenv"
    [ -s "$ENVFILE" ] || fail 'GRUB environment file is missing'
}
get_env() {
    grub-editenv "$ENVFILE" list 2>/dev/null | sed -n "s/^$1=//p" | head -n 1
}
mark_good() {
    if [ "$trial" = "$SLOT" ]; then
        grub-editenv "$ENVFILE" set "zarya_default=$SLOT" zarya_trial= zarya_tries=0
        sync
        logger -t zarya-ota "confirmed slot $SLOT as good"
        echo "[zarya-ota-init] Slot $SLOT confirmed after KDE Plasma initialized; rollback point advanced."
    fi
}

mount_esp
default=$(get_env zarya_default)
trial=$(get_env zarya_trial)
tries=$(get_env zarya_tries)

case "$ACTION" in
    --status)
        printf 'Active slot: %s\nVersion: %s\nGRUB default: %s\nTrial slot: %s\nTrial boots remaining: %s\n' \
            "$SLOT" "$(cat /etc/zarya-version 2>/dev/null || echo unknown)" \
            "${default:-unknown}" "${trial:-none}" "${tries:-0}"
        ;;
    --mark-good)
        mark_good
        ;;
    --confirm-desktop)
        # Stable boots do not need a confirmation. The service only waits during
        # an OTA trial, and confirms only after both KWin and Plasma are running.
        if [ "$trial" != "$SLOT" ] || [ "$default" = "$SLOT" ]; then
            exit 0
        fi
        if ! command -v pgrep >/dev/null 2>&1; then
            fail 'pgrep is required to verify the KDE Plasma session'
        fi
        uid=$(id -u zarya 2>/dev/null) || fail 'the zarya desktop account is missing'
        timeout=${ZARYA_OTA_DESKTOP_TIMEOUT:-150}
        [[ "$timeout" =~ ^[0-9]+$ ]] || timeout=150
        umount "$ESP_DIR"
        ESP_MOUNTED=0
        for ((elapsed=0; elapsed<timeout; elapsed+=2)); do
            if [ -S "/run/user/$uid/bus" ] && \
                    pgrep -u "$uid" -x kwin_wayland >/dev/null 2>&1 && \
                    pgrep -u "$uid" -x plasmashell >/dev/null 2>&1; then
                mount_esp
                default=$(get_env zarya_default)
                trial=$(get_env zarya_trial)
                if [ "$trial" = "$SLOT" ] && [ "$default" != "$SLOT" ]; then
                    mark_good
                fi
                exit 0
            fi
            sleep 2
        done
        fail "KDE Plasma did not become ready within ${timeout}s; the boot watchdog will roll back"
        ;;
    --watchdog)
        # Only trial boots need a timer. Leave EFI unmounted while waiting so
        # the desktop confirmation service can safely update grubenv.
        if [ "$trial" != "$SLOT" ] || [ "$default" = "$SLOT" ]; then
            exit 0
        fi
        umount "$ESP_DIR"
        ESP_MOUNTED=0
        rmdir "$ESP_DIR"
        ESP_DIR=$(mktemp -d /run/zarya-ota-watchdog.XXXXXX)
        sleep "${ZARYA_OTA_WATCHDOG_SECONDS:-180}"
        mount_esp
        default=$(get_env zarya_default)
        trial=$(get_env zarya_trial)
        if [ "$trial" = "$SLOT" ] && [ "$default" != "$SLOT" ]; then
            logger -t zarya-ota "slot $SLOT did not confirm within watchdog interval; rebooting for rollback"
            sync
            /sbin/reboot -f
        fi
        ;;
    *)
        echo 'Usage: zarya-ota-init --mark-good | --status | --watchdog | --confirm-desktop' >&2
        exit 2
        ;;
esac
