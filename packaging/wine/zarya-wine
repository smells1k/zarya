#!/bin/sh
# Launch a Windows application in the current Kubuntu Plasma desktop session.
set -eu

if [ "${1:-}" = "install" ]; then
    shift
    if [ "$(id -u)" -ne 0 ]; then
        exec sudo -E "$0" install "$@"
    fi
    echo '[zarya-wine] Enabling i386 packages and installing Wine for KDE Plasma.'
    dpkg --add-architecture i386
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y \
        wine wine64 wine32:i386 fonts-wine wine-binfmt
    echo '[zarya-wine] Ready. Run zarya-wine /path/to/program.exe from the Plasma session.'
    exit 0
fi

if [ "${1:-}" = "--help" ] || [ "$#" -ne 1 ]; then
    echo 'Usage: zarya-wine install | zarya-wine /path/to/program.exe' >&2
    exit 2
fi
EXE=$(realpath -- "$1")
[ -f "$EXE" ] || { echo "Not a file: $EXE" >&2; exit 1; }
command -v wine >/dev/null 2>&1 || { echo 'Wine is not installed; run sudo zarya-wine install.' >&2; exit 1; }
export WINEPREFIX="${WINEPREFIX:-$HOME/.wine}"

# The Kubuntu Wayland session supplies XWayland for classic Win32 applications.
# Use a Wine virtual desktop, not the old Zarya framebuffer/Xorg side session.
resolution=1280x800
if [ -n "${DISPLAY:-}" ] && command -v xrandr >/dev/null 2>&1; then
    detected=$(xrandr --current 2>/dev/null | awk '/ connected/ {for (i=1; i<=NF; i++) if ($i ~ /^[0-9]+x[0-9]+\+/) {sub(/\+.*/, "", $i); print $i; exit}}')
    [ -z "$detected" ] || resolution=$detected
fi
exec wine explorer "/desktop=Zarya,$resolution" "$EXE"
