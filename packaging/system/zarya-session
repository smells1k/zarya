#!/bin/sh
# Login-session supervisor for the live and installed Zarya desktop.
set -u
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export HOME=/home/zarya
RUN_DIR=/run/zarya
LOG_DIR=$RUN_DIR/log
SESSION_LOG=$LOG_DIR/session.log
mkdir -p "$LOG_DIR" 2>/dev/null || true

reset_tty() {
    stty sane < /dev/tty >/dev/null 2>&1 || true
}

while :; do
    rm -f "$RUN_DIR/quit"
    reset_tty
    /usr/bin/python3 /usr/lib/zarya/shell.py >>"$SESSION_LOG" 2>&1
    rc=$?
    reset_tty

    if [ -s "$RUN_DIR/quit" ]; then
        action=$(cat "$RUN_DIR/quit" 2>/dev/null || echo poweroff)
        rm -f "$RUN_DIR/quit"
        case "$action" in
            reboot) sudo /sbin/reboot -f ;;
            *) sudo /sbin/poweroff -f ;;
        esac
        sleep 3600
    fi

    if [ -s "$RUN_DIR/wine-request" ]; then
        exe=$(sed -n '1p' "$RUN_DIR/wine-request" 2>/dev/null || true)
        rm -f "$RUN_DIR/wine-request"
        if [ -n "$exe" ] && [ -f "$exe" ] && \
                command -v xinit >/dev/null 2>&1 && command -v wine >/dev/null 2>&1; then
            xinit /usr/local/bin/zarya-wine "$exe" -- :0 vt1 -keeptty -nolisten tcp
            rc=$?
            reset_tty
        else
            printf '\nWine is not ready. Install it with: sudo zarya-wine install\n' > /dev/tty1 2>/dev/null || true
            sleep 4
        fi
    fi

    if [ "$rc" -ne 0 ]; then
        printf '[%s] desktop exited with status %s\n' \
            "$(date +%T 2>/dev/null || echo unknown)" "$rc" >>"$SESSION_LOG" 2>/dev/null || true
        sleep 2
    else
        sleep 1
    fi
done
